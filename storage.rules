rules_version = '2';

// Regras de segurança do Storage — Noite Goiana
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Imagens de capa/banner de eventos: leitura pública, upload só admin.
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Fotos do evento: NÃO ficam aqui — usamos o Vercel Blob (o Firebase
    // Storage passou a exigir o plano pago Blaze mesmo pra uso pequeno,
    // desde fev/2026). Ver backend/api/photos-upload.ts e src/services/photoService.ts.

    // PDFs de ingressos: gerados e lidos apenas pelo backend (Admin SDK),
    // nunca diretamente pelo client SDK.
    match /tickets/{ticketId}/{fileName} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// Regras de segurança do Firestore — Noite Goiana
// Princípio: o cliente nunca escreve diretamente em coleções sensíveis
// (tickets, payments, checkins). Essas escritas só acontecem via Cloud
// Functions, usando o Admin SDK (que ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Perfis de usuário: cada um só lê/edita o próprio perfil; admin lê todos.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Lista de administradores — só o próprio backend (Admin SDK) escreve aqui.
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Eventos e categorias: leitura pública (site é público), escrita só admin.
    match /events/{eventId} {
      allow read: if resource.data.status in ['publicado', 'esgotado'] || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ingressos: o comprador só pode LER os próprios; toda escrita é do backend.
    match /tickets/{ticketId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.compradorEmail == request.auth.token.email);
      allow write: if false; // somente Cloud Functions (Admin SDK)
    }

    // Pagamentos: nunca legíveis/graváveis pelo cliente — só pelo backend.
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Check-ins: leitura só para admin/operador; escrita só pelo backend.
    match /checkins/{checkinId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ticketLots/{lotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}

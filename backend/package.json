{
  "name": "noite-goiana-backend",
  "private": true,
  "description": "Backend da Noite Goiana rodando no Vercel: pagamentos (Mercado Pago), cupons, cortesias, geração de ingressos/QR Code, envio de e-mail, upload de fotos (Vercel Blob) e validação de check-in.",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^12.5.0",
    "mercadopago": "^2.0.15",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1",
    "zod": "^3.23.8",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "@vercel/blob": "latest"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.11",
    "typescript": "^5.5.4",
    "@types/node": "^22.5.4",
    "@types/uuid": "^9.0.8",
    "@types/qrcode": "^1.5.5",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.13.4"
  }
}

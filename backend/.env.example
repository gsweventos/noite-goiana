# ============================================================
# Noite Goiana — variáveis de ambiente do BACKEND (Vercel)
# NUNCA versionar o .env real. No Vercel, configure em:
#   Project Settings → Environment Variables
# ============================================================

# Access Token PRIVADO do Mercado Pago (Suas integrações > Credenciais de produção)
MP_ACCESS_TOKEN=

# URL pública do backend (depois do primeiro deploy, o Vercel te dá esse
# endereço, ex.: https://noite-goiana-backend.vercel.app/api)
PUBLIC_API_URL=

# URL pública do frontend (GitHub Pages / domínio próprio)
PUBLIC_APP_URL=https://www.noitegoiana.com.br

# Segredo usado para assinar (HMAC) o payload de cada QR Code de ingresso
QR_SECRET=

# --- Firebase Admin (conta de serviço) ---
# Firebase Console → Configurações do projeto → Contas de serviço →
# "Gerar nova chave privada" (baixa um arquivo .json com esses 3 valores)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- E-mail transacional (opcional, envio do PDF do ingresso) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Noite Goiana <contato@noitegoiana.com.br>"

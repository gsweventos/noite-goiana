# ============================================================
# Noite Goiana — variáveis de ambiente do BACKEND (Cloud Functions)
# NUNCA versionar o .env real. Configure em produção com:
#   firebase functions:secrets:set MP_ACCESS_TOKEN
#   firebase functions:secrets:set QR_SECRET
#   firebase functions:secrets:set SMTP_PASSWORD
# ============================================================

# Access Token PRIVADO do Mercado Pago (Suas integrações > Credenciais de produção)
MP_ACCESS_TOKEN=

# URL pública do backend, usada para montar back_urls e notification_url
PUBLIC_API_URL=https://us-central1-noite-goiana.cloudfunctions.net/api

# URL pública do frontend, usada nas back_urls do Checkout Pro
PUBLIC_APP_URL=https://www.noitegoiana.com.br

# Segredo usado para assinar (HMAC) o payload de cada QR Code de ingresso
QR_SECRET=

# E-mail transacional (envio do PDF do ingresso)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Noite Goiana <contato@noitegoiana.com.br>"

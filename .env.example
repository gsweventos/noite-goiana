# ============================================================
# Noite Goiana — variáveis de ambiente do FRONTEND (Vite)
# Copie este arquivo para ".env" e preencha com os valores reais.
# Nenhuma dessas chaves é secreta: são todas chaves PÚBLICAS de
# client SDK. Segredos (Access Token do Mercado Pago, etc.) ficam
# só no backend — nunca aqui.
# ============================================================

# --- Firebase (Configurações do projeto > Config do SDK) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=noite-goiana.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=noite-goiana
VITE_FIREBASE_STORAGE_BUCKET=noite-goiana.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Backend próprio (Cloud Functions / Cloud Run / Vercel Functions) ---
# URL base da API que cria preferências de pagamento e valida check-ins.
# Ex.: https://us-central1-noite-goiana.cloudfunctions.net/api
VITE_API_BASE_URL=

# --- Mercado Pago ---
# Public Key (não é secreta) — usada apenas se você optar pelo Checkout
# Transparente com Bricks no frontend. Para Checkout Pro (recomendado
# neste projeto), não é necessária no frontend.
VITE_MERCADOPAGO_PUBLIC_KEY=
